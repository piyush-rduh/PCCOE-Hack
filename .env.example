PORT=3000
NODE_ENV=development
AGCRO_DATA_FILE=./data/agcro-store.json

# Security and Authentication
# Set a strong, cryptographically random secret in production (e.g. openssl rand -base64 32)
JWT_SECRET=agcro-mvp-secure-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Optional managed MySQL-compatible database DSN.
DATABASE_URL=mysql://user:password@host:3306/agcro

# Optional verified provider integration; never place these in frontend code.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
NEUGEN_API_URL=
NEUGEN_API_KEY=
